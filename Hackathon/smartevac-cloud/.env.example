# AWS Academy Learner Lab 憑證
# 從 Learner Lab 的 "AWS Details" > "AWS CLI" 複製
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=your_session_token_here
AWS_DEFAULT_REGION=us-east-1

# ── SmartEvac 雲端資源設定 ────────────────────────────────────────────
# S3 bucket 名稱（全 AWS 唯一，建議 smartevac-<你的名字>）
OUTPUT_BUCKET=smartevac-your-name

# Google API keys（兩把分開）
# Gemini key：aistudio.google.com/apikey
GOOGLE_API_KEY=
# TTS key：console.cloud.google.com 憑證頁另建一把，限定 Cloud TTS API
GOOGLE_TTS_API_KEY=

GEMINI_MODEL=gemini-2.5-flash-lite
GOOGLE_TTS_VOICE=cmn-TW-Wavenet-A

# IoT Core 設定
# 用 aws iot describe-endpoint --endpoint-type iot:Data-ATS 取得
IOT_ENDPOINT=xxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com
IOT_TOPIC_PREFIX=smartevac/cmd
TELEMETRY_TOPIC_PREFIX=smartevac/telemetry

# ScenarioTrigger 內建的閾值（決定 alert_level=alert 的判斷）
ALERT_THRESHOLD_MQ2=0.5
ALERT_THRESHOLD_MQ135=0.7
ALERT_THRESHOLD_TEMP=35

# Presigned URL 有效期（秒）
PRESIGNED_URL_TTL=600
